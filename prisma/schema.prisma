generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("PARTNER")
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  fcmToken     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id])

  owners Owner[]
}

model Partner {
  id             String   @id @default(cuid())
  name           String
  email          String?  @unique
  phone          String?
  city           String?
  cities         String[] @default([])
  royaltyPercent Float    @default(3)
  isActive       Boolean  @default(true)
  comment        String?
  maxBotToken    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users   User[]
  reports RoyaltyReport[]
  owners  Owner[]
  clients Client[]
  groups  TelegramGroup[]
  orders  Order[]
}

model Owner {
  id              String   @id @default(cuid())
  name            String
  phone           String
  email           String?
  company         String?
  city            String?
  address         String?
  lat             Float?
  lng             Float?
  comment         String?
  notes           String?
  isActive        Boolean  @default(true)
  isRegistered    Boolean  @default(false)
  isOnShift       Boolean  @default(true)
  rating          Float    @default(4.5)
  completedOrders Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  vehicles Vehicle[]
  logs     MessageLog[]
  takes    OrderTake[]
}

model Vehicle {
  id      String @id @default(cuid())
  ownerId String
  owner   Owner  @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  category String
  brand    String?
  model    String?
  year     Int?
  comment  String?

  createdAt DateTime @default(now())
}

model Client {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  company   String?
  inn       String?
  kpp       String?
  ogrn      String?
  address   String?
  comment   String?

  bankName        String?
  bankAccount     String?
  bankBik         String?
  bankCorrAccount String?

  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id])

  createdAt DateTime @default(now())
  orders    Order[]
}

model TelegramGroup {
  id        String   @id @default(cuid())
  title     String
  chatId    String
  category  String?
  isActive  Boolean  @default(true)
  messenger String   @default("telegram")
  createdAt DateTime @default(now())

  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id])

  orderGroups OrderGroup[]

  @@unique([messenger, chatId])
}

model Order {
  id              String    @id @default(cuid())
  category        String
  city            String?
  startAt         DateTime?
  when            String?
  description     String?
  dispatcher      String
  dispatcherPhone String

  status             String    @default("ACTIVE")
  result             String?
  closedInTelegram   Boolean   @default(false)
  closedInTelegramAt DateTime?
  closedInApp        Boolean   @default(false)

  assigneeName  String?
  assigneePhone String?

  orderAmount      Int?
  commissionAmount Int?

  publishedInApp Boolean @default(false)

  clientId    String?
  client      Client? @relation(fields: [clientId], references: [id])
  clientName  String?
  clientPhone String?

  createdAt DateTime  @default(now())
  closedAt  DateTime?

  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id])

  groups OrderGroup[]
  logs   MessageLog[]
  takes  OrderTake[]
}

model OrderGroup {
  id      String        @id @default(cuid())
  orderId String
  order   Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  groupId String
  group   TelegramGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model OrderTake {
  id                     String    @id @default(cuid())
  orderId                String
  order                  Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ownerId                String
  owner                  Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  status                 String    @default("TAKEN")
  takenAt                DateTime  @default(now())
  canceledAt             DateTime?
  cancelReason           String?
  ratingImpact           Float?
  clientContactsShared   Boolean   @default(false)
  clientContactsSharedAt DateTime?

  @@index([orderId])
  @@index([ownerId])
}

model MessageLog {
  id        String   @id @default(cuid())
  channel   String
  target    String
  chatId    String?
  messageId String?
  text      String
  status    String
  error     String?
  createdAt DateTime @default(now())

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])
  ownerId String?
  owner   Owner?  @relation(fields: [ownerId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  orderId   String?
  ownerId   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
}

model RoyaltyReport {
  id          String   @id @default(cuid())
  periodStart DateTime
  periodEnd   DateTime

  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id])

  revenue Int @default(0)

  taxRate   Float @default(0)
  taxAmount Int   @default(0)

  salaries       Int     @default(0)
  officeRent     Int     @default(0)
  communications Int     @default(0)
  otherExpenses  Int     @default(0)
  otherNote      String?

  totalExpenses Int @default(0)
  netProfit     Int @default(0)

  royaltyPercent Float @default(0)
  royaltyAmount  Int   @default(0)

  createdAt DateTime @default(now())
}
